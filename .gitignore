# Post-deadline .gitignore (blacklist). Publishes code, plan, results, report and run logs.

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
.venv
.venv/
venv/
__pycache__/
*.py[cod]
.DS_Store
.pytest_cache/

# Agent workspace notes (local only)
CLAUDE.md
docs/notes/
reports/
research_notes/
docs/self_study/

# Third-party code, datasets and paper PDFs (re-download: starter/swarm_alignment/README.md)
starter/swarm_alignment/*/
!starter/swarm_alignment/README.md
docs/sprint/papers/*/
docs/incident/sources/
docs/sprint/external/
docs/misc./

# Scratch and LaTeX build products
results/_verify_*/
report/latex/*.aux
report/latex/*.log
report/latex/*.out
report/latex/*.toc
report/latex/*.xdv
report/latex/*.fls
report/latex/*.fdb_latexmk
